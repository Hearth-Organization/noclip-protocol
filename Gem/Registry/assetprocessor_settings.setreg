{
    "Amazon": {
        "AssetProcessor": {
            "Settings": {
                "ScanFolder NoclipProtocol/Assets": {
                    "watch": "@GEMROOT:NoclipProtocol@/Assets",
                    "recursive": 1,
                    "order": 101
                },
                "ScanFolder NoclipProtocol/Registry": {
                    "watch": "@GEMROOT:NoclipProtocol@/Registry",
                    "recursive": 1,
                    "order": 102
                }
            }
        }
    }
}
